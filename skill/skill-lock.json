{
  "name": "arkiv-sync",
  "version": "2.0.0",
  "title": "Chain \u2192 Arkiv Indexer",
  "oneLiner": "Point at any EVM contract and turn its events into a queryable Arkiv database \u2014 reorg-safe, idempotent, resumable.",
  "teaches": [
    "indexing EVM events into Arkiv",
    "declarative contract+event config",
    "event \u2192 entity mapping",
    "reorg-safe re-derivation",
    "idempotency by chainId:txHash:logIndex",
    "querying the derived database",
    "multichain via source adapters"
  ],
  "npm": {
    "package": "arkiv-sync",
    "version": "1.0.0",
    "bin": "arkiv-sync",
    "create": "create-arkiv-sync"
  },
  "sdk": {
    "package": "@arkiv-network/sdk",
    "range": "^1.0.0",
    "verified": "1.0.0"
  },
  "viem": {
    "range": "^2.38.2",
    "note": "direct dependency: the source reads a non-Arkiv chain"
  },
  "node": {
    "range": ">=20 <24",
    "note": "Node 24 hangs Arkiv entity updates (arkiv-sdk-js #14)"
  },
  "network": {
    "sink": {
      "name": "rabdi",
      "chainId": 7794095,
      "rpc": "https://rpc.rabdi.db-chain.testnet.arkiv.network/<accessKey>",
      "faucet": "https://hub.arkiv.network/faucet",
      "accessKeys": "https://hub.arkiv.network/access-keys",
      "explorer": "https://rabdi.explorer.arkiv.network"
    },
    "source": {
      "note": "Source reads are unsigned; default sink is Rabdi testnet",
      "chains": {
        "ethereum": 1,
        "sepolia": 11155111,
        "base": 8453,
        "base-sepolia": 84532,
        "bsc": 56,
        "bsc-testnet": 97
      }
    }
  },
  "surface": [
    "defineConfig",
    "createIndexer",
    "quickCheck",
    "normalizeAddresses",
    "Indexer",
    "EvmSource",
    "ArkivSink",
    "ArkivNetwork",
    "assertWritableChain",
    "createArkivReader",
    "SOURCE_CHAINS",
    "resolveSourceChain",
    "FileCursorStore",
    "MemoryCursorStore",
    "detectReorg",
    "seconds",
    "minutes",
    "hours",
    "days",
    "weeks",
    "describeSeconds",
    "eventId",
    "lower",
    "addr",
    "uint",
    "scrubSecrets",
    "quoteValue",
    "assertSafePredicate",
    "assertSafeOwner",
    "createLogger",
    "silentLogger",
    "NormalizedEvent",
    "EventMapper",
    "MappedEntity",
    "Sink",
    "SourceAdapter",
    "QueryParams",
    "DecodedEntity",
    "createRabdiNetwork",
    "WriteOperation"
  ],
  "decides": [
    "confirmed source logs, atomic checkpoints and reorg re-derivation",
    "expirationSeconds, below Rabdi maximum lifetime",
    "owner/schema/sync isolation and SHA256 replay",
    "unsigned latest estimate, doubled gas, half-block ceiling, bounded retry"
  ],
  "messaging": {
    "lead": "the Web3 database",
    "ai-vertical": "ephemeral coordination state"
  },
  "last-verified-at": "2026-10-31",
  "evidence": "See docs/verification.md; candidate verification and publication are separate."
}
