{
  "name": "arkiv-sync",
  "version": "1.0.1",
  "description": "Index EVM contract events into Arkiv with configurable sources, checkpointed progress, and reorg recovery.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "arkiv-sync": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "arkiv.config.example.ts",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "docs/verification.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "tsx src/bin/cli.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx test/run.ts && tsx test/review-regressions.ts && tsx test/missing-key-no-network.ts && tsx test/write-operation.ts",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "lint": "node scripts/lint.mjs"
  },
  "keywords": [
    "arkiv",
    "indexer",
    "evm",
    "ethereum",
    "sepolia",
    "events",
    "queryable",
    "web3",
    "subgraph",
    "viem"
  ],
  "author": "Santiago (Arkiv DevRel)",
  "license": "MIT",
  "engines": {
    "node": ">=20 <24"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@arkiv-network/sdk": "1.0.0",
    "@types/node": "22.19.21",
    "esbuild": "0.24.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@arkiv-network/sdk": "^1.0.0"
  }
}
