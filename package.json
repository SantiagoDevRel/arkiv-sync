{
  "name": "arkiv-sync",
  "version": "0.3.0",
  "description": "Index EVM contract events into Arkiv with configurable sources, checkpointed progress, and reorg recovery.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "arkiv-sync": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "arkiv.config.example.ts",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "docs/sdk-0.8.1-evidence.json",
    "docs/current-candidate-evidence.json",
    "docs/verification.md"
  ],
  "scripts": {
    "start": "tsx src/bin/cli.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx test/run.ts && tsx test/sdk08.ts && tsx test/missing-key-no-network.ts",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs"
  },
  "keywords": [
    "arkiv",
    "indexer",
    "evm",
    "ethereum",
    "sepolia",
    "events",
    "queryable",
    "web3",
    "subgraph",
    "viem"
  ],
  "author": "Santiago (Arkiv DevRel)",
  "license": "MIT",
  "engines": {
    "node": ">=20 <24"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "dotenv": "^17.4.2",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
